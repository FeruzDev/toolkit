{
  "name": "tiny-uuidv7",
  "version": "1.0.0",
  "description": "Tiny, fast, monotonic UUIDv7 (RFC 9562) generator — time-sortable IDs ideal as database primary keys. Browser, Node, Bun, Deno, edge. Extract timestamps, validate, plus uuidv4.",
  "keywords": [
    "uuid",
    "uuidv7",
    "uuid v7",
    "rfc 9562",
    "time ordered",
    "sortable id",
    "primary key",
    "ulid alternative",
    "nanoid alternative",
    "cuid alternative",
    "database id",
    "typescript"
  ],
  "license": "MIT",
  "author": "FeruzDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeruzDev/toolkit.git",
    "directory": "packages/tiny-uuidv7"
  },
  "homepage": "https://github.com/FeruzDev/toolkit/tree/main/packages/tiny-uuidv7#readme",
  "bugs": {
    "url": "https://github.com/FeruzDev/toolkit/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --target es2020"
  },
  "publishConfig": {
    "access": "public"
  }
}
