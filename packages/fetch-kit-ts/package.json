{
  "name": "fetch-kit-ts",
  "version": "1.0.0",
  "description": "Tiny typed fetch wrapper (~2 KB): base URL, JSON, query params, timeout, retry with backoff, interceptors and typed errors. A lightweight axios / ky alternative for browser, Node, Bun, Deno and edge.",
  "keywords": [
    "fetch",
    "http",
    "http client",
    "axios alternative",
    "ky alternative",
    "ofetch",
    "retry",
    "timeout",
    "interceptors",
    "typescript",
    "api client",
    "request",
    "rest"
  ],
  "license": "MIT",
  "author": "FeruzDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeruzDev/toolkit.git",
    "directory": "packages/fetch-kit-ts"
  },
  "homepage": "https://github.com/FeruzDev/toolkit/tree/main/packages/fetch-kit-ts#readme",
  "bugs": {
    "url": "https://github.com/FeruzDev/toolkit/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --target es2020"
  },
  "publishConfig": {
    "access": "public"
  }
}
