{
  "name": "duration-i18n",
  "version": "1.0.0",
  "description": "Format durations and relative time in 100+ languages using the built-in Intl API — zero locale files. parse and ms() compatible. Tiny, tree-shakeable replacement for ms, humanize-duration and pretty-ms.",
  "keywords": [
    "duration",
    "humanize",
    "humanize-duration alternative",
    "ms alternative",
    "pretty-ms",
    "time ago",
    "relative time",
    "i18n",
    "intl",
    "format duration",
    "parse duration",
    "uzbek",
    "russian",
    "typescript"
  ],
  "license": "MIT",
  "author": "FeruzDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeruzDev/toolkit.git",
    "directory": "packages/duration-i18n"
  },
  "homepage": "https://github.com/FeruzDev/toolkit/tree/main/packages/duration-i18n#readme",
  "bugs": {
    "url": "https://github.com/FeruzDev/toolkit/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --target es2020"
  },
  "publishConfig": {
    "access": "public"
  }
}
