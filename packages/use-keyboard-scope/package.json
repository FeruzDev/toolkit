{
  "name": "use-keyboard-scope",
  "version": "1.0.0",
  "description": "Scoped keyboard shortcuts for React: hotkeys that belong to a modal, panel or page and automatically block the ones underneath. Sequences (g i), mod key for Mac/Windows, works with non-Latin keyboard layouts, help-dialog list.",
  "keywords": [
    "react",
    "hook",
    "hotkeys",
    "keyboard shortcuts",
    "keybindings",
    "scope",
    "modal",
    "command palette",
    "react-hotkeys-hook alternative",
    "mousetrap alternative",
    "accessibility",
    "typescript"
  ],
  "license": "MIT",
  "author": "FeruzDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeruzDev/toolkit.git",
    "directory": "packages/use-keyboard-scope"
  },
  "homepage": "https://github.com/FeruzDev/toolkit/tree/main/packages/use-keyboard-scope#readme",
  "bugs": {
    "url": "https://github.com/FeruzDev/toolkit/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean --sourcemap --target es2020 --external react"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
