{
  "name": "use-optimistic-list",
  "version": "1.0.0",
  "description": "React hook for optimistic CRUD lists: create, update, remove and reorder instantly, reconcile with the server response, and roll back only the failed operation — safe with concurrent requests. Works with any API.",
  "keywords": [
    "react",
    "hook",
    "optimistic ui",
    "optimistic update",
    "crud",
    "rollback",
    "list",
    "todo",
    "useOptimistic alternative",
    "react-query",
    "mutations",
    "typescript"
  ],
  "license": "MIT",
  "author": "FeruzDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeruzDev/toolkit.git",
    "directory": "packages/use-optimistic-list"
  },
  "homepage": "https://github.com/FeruzDev/toolkit/tree/main/packages/use-optimistic-list#readme",
  "bugs": {
    "url": "https://github.com/FeruzDev/toolkit/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --target es2020 --external react"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
