{
  "name": "dotenv-validate",
  "version": "1.0.0",
  "description": "Load .env files and validate environment variables with full TypeScript types and clear error messages. dotenv + envalid/zod-env in one tiny zero-dependency package.",
  "keywords": [
    "dotenv",
    "env",
    "environment variables",
    "validation",
    "typescript",
    "config",
    "envalid alternative",
    "t3-env alternative",
    "zod env",
    ".env",
    "process.env",
    "schema"
  ],
  "license": "MIT",
  "author": "FeruzDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeruzDev/toolkit.git",
    "directory": "packages/dotenv-validate"
  },
  "homepage": "https://github.com/FeruzDev/toolkit/tree/main/packages/dotenv-validate#readme",
  "bugs": {
    "url": "https://github.com/FeruzDev/toolkit/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --target es2020"
  },
  "publishConfig": {
    "access": "public"
  }
}
