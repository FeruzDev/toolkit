{
  "name": "use-typed-url-state",
  "version": "1.0.0",
  "description": "Type-safe React state synced with URL query params: numbers, booleans, enums, arrays, dates and JSON with defaults. Shareable, back-button friendly filters and pagination. Lightweight nuqs / use-query-params alternative.",
  "keywords": [
    "react",
    "hook",
    "url state",
    "query params",
    "search params",
    "querystring",
    "useSearchParams",
    "nuqs alternative",
    "use-query-params alternative",
    "filters",
    "pagination",
    "next.js",
    "typescript"
  ],
  "license": "MIT",
  "author": "FeruzDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeruzDev/toolkit.git",
    "directory": "packages/use-typed-url-state"
  },
  "homepage": "https://github.com/FeruzDev/toolkit/tree/main/packages/use-typed-url-state#readme",
  "bugs": {
    "url": "https://github.com/FeruzDev/toolkit/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --target es2020 --external react"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
