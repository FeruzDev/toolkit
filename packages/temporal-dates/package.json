{
  "name": "temporal-dates",
  "version": "1.0.0",
  "description": "date-fns style helpers built on the Temporal API: add, diff, startOf, format, compare, time zones. Same type in, same type out (works with Date too). Native Temporal or any polyfill. A future-proof date-fns / dayjs alternative.",
  "keywords": [
    "temporal",
    "temporal api",
    "date",
    "time",
    "timezone",
    "date-fns alternative",
    "dayjs alternative",
    "moment alternative",
    "luxon alternative",
    "format date",
    "polyfill",
    "typescript"
  ],
  "license": "MIT",
  "author": "FeruzDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeruzDev/toolkit.git",
    "directory": "packages/temporal-dates"
  },
  "homepage": "https://github.com/FeruzDev/toolkit/tree/main/packages/temporal-dates#readme",
  "bugs": {
    "url": "https://github.com/FeruzDev/toolkit/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --target es2020"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "temporal-spec": "^1.0.1"
  }
}
