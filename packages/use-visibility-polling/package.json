{
  "name": "use-visibility-polling",
  "version": "1.0.0",
  "description": "React polling hook that pauses when the tab is hidden or offline, refetches instantly when the user comes back, never overlaps requests, backs off on errors and supports abort. Saves server load and battery.",
  "keywords": [
    "react",
    "hook",
    "polling",
    "interval",
    "page visibility",
    "visibilitychange",
    "refetch",
    "background tab",
    "offline",
    "abortcontroller",
    "backoff",
    "dashboard",
    "typescript"
  ],
  "license": "MIT",
  "author": "FeruzDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeruzDev/toolkit.git",
    "directory": "packages/use-visibility-polling"
  },
  "homepage": "https://github.com/FeruzDev/toolkit/tree/main/packages/use-visibility-polling#readme",
  "bugs": {
    "url": "https://github.com/FeruzDev/toolkit/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --target es2020 --external react"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
