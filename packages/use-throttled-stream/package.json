{
  "name": "use-throttled-stream",
  "version": "1.0.0",
  "description": "React hook that batches high-frequency streams (WebSocket, SSE, any subscribe function) into throttled state updates — append window, latest value or custom reducer. Keeps UIs smooth at thousands of messages per second.",
  "keywords": [
    "react",
    "hook",
    "websocket",
    "throttle",
    "batch",
    "stream",
    "sse",
    "eventsource",
    "realtime",
    "live data",
    "performance",
    "buffer",
    "typescript"
  ],
  "license": "MIT",
  "author": "FeruzDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeruzDev/toolkit.git",
    "directory": "packages/use-throttled-stream"
  },
  "homepage": "https://github.com/FeruzDev/toolkit/tree/main/packages/use-throttled-stream#readme",
  "bugs": {
    "url": "https://github.com/FeruzDev/toolkit/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --target es2020 --external react"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
