{
  "name": "use-live-announcer",
  "version": "1.0.0",
  "description": "Announce alarms and important dashboard changes to screen readers (aria-live) in React and vanilla JS. Tiny, SSR-safe, de-duplicated, throttled.",
  "keywords": [
    "react",
    "hook",
    "aria-live",
    "accessibility",
    "a11y",
    "screen reader",
    "announcer",
    "live region",
    "wcag",
    "dashboard",
    "alerts",
    "react-aria-live alternative"
  ],
  "license": "MIT",
  "author": "FeruzDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeruzDev/toolkit.git",
    "directory": "packages/use-live-announcer"
  },
  "homepage": "https://github.com/FeruzDev/toolkit/tree/main/packages/use-live-announcer#readme",
  "bugs": {
    "url": "https://github.com/FeruzDev/toolkit/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --target es2020 --external react"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
