{
  "name": "use-offline-actions",
  "version": "1.0.0",
  "description": "React hook for an offline-first action queue: save actions while offline (persisted in localStorage), auto-sync when back online with retries and backoff, cross-tab safe, failed-item handling. Outbox pattern in one hook.",
  "keywords": [
    "react",
    "hook",
    "offline",
    "offline first",
    "queue",
    "outbox",
    "sync",
    "background sync",
    "retry",
    "pwa",
    "localstorage",
    "network",
    "online",
    "typescript"
  ],
  "license": "MIT",
  "author": "FeruzDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeruzDev/toolkit.git",
    "directory": "packages/use-offline-actions"
  },
  "homepage": "https://github.com/FeruzDev/toolkit/tree/main/packages/use-offline-actions#readme",
  "bugs": {
    "url": "https://github.com/FeruzDev/toolkit/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --target es2020 --external react"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
