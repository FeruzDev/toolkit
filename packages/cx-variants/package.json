{
  "name": "cx-variants",
  "version": "1.0.0",
  "description": "clsx + cva + tailwind-merge in one tiny package: conditional class names, type-safe variants and built-in Tailwind conflict resolution. Drop-in cn() for shadcn/ui.",
  "keywords": [
    "tailwind",
    "tailwindcss",
    "clsx",
    "classnames",
    "cva",
    "class-variance-authority",
    "tailwind-merge",
    "tailwind-variants",
    "cn",
    "shadcn",
    "variants",
    "className",
    "react"
  ],
  "license": "MIT",
  "author": "FeruzDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeruzDev/toolkit.git",
    "directory": "packages/cx-variants"
  },
  "homepage": "https://github.com/FeruzDev/toolkit/tree/main/packages/cx-variants#readme",
  "bugs": {
    "url": "https://github.com/FeruzDev/toolkit/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --target es2020"
  },
  "publishConfig": {
    "access": "public"
  }
}
