{
  "name": "use-stale-data",
  "version": "1.0.0",
  "description": "React hook that tells you when data is stale: fresh / warning / stale status, live age (\"updated 2 min ago\"), callbacks. Works with fetch, React Query, SWR and WebSockets.",
  "keywords": [
    "react",
    "hook",
    "stale data",
    "staleness",
    "freshness",
    "last updated",
    "data age",
    "dashboard",
    "react-query",
    "swr",
    "websocket",
    "outdated",
    "typescript"
  ],
  "license": "MIT",
  "author": "FeruzDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeruzDev/toolkit.git",
    "directory": "packages/use-stale-data"
  },
  "homepage": "https://github.com/FeruzDev/toolkit/tree/main/packages/use-stale-data#readme",
  "bugs": {
    "url": "https://github.com/FeruzDev/toolkit/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --target es2020 --external react"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
